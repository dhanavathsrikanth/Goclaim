{
  "$schema": "dodo-nextjs/node_modules/wrangler/config-schema.json",
  "name": "goclaim-space",
  "main": "dodo-nextjs/.open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    // Enable Node.js APIs (Buffer, crypto, etc.) that Next.js needs
    "nodejs_compat",
    // Correct fetch behavior from inside the Worker
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": "dodo-nextjs/.open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "goclaim-space"
    }
  ],
  "build": {
    "command": "npm --prefix dodo-nextjs run build:worker"
  }
}
